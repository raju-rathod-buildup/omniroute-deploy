diff --git a/src/app/(dashboard)/dashboard/providers/hooks/useProviderConnectionOptions.ts b/src/app/(dashboard)/dashboard/providers/hooks/useProviderConnectionOptions.ts
new file mode 100644
index 000000000..f5e534773
--- /dev/null
+++ b/src/app/(dashboard)/dashboard/providers/hooks/useProviderConnectionOptions.ts
@@ -0,0 +1,60 @@
+"use client";
+
+import { useEffect, useState } from "react";
+
+export interface ProviderConnectionOption {
+  id: string;
+  name?: string;
+  isActive?: boolean;
+  testStatus?: string;
+}
+
+interface UseProviderConnectionOptionsResult {
+  connections: ProviderConnectionOption[];
+  loading: boolean;
+}
+
+/**
+ * useProviderConnectionOptions — fetch this provider's connections from
+ * GET /api/providers?provider=<id> for a playground "Connection" picker.
+ *
+ * Lets the playground pin a specific upstream account (via the
+ * X-OmniRoute-Connection request header) instead of always letting normal
+ * fallback/round-robin pick among the provider's connections — useful for
+ * reproducing an issue on one particular account. Distinct from the
+ * "Select Key" control, which picks an OmniRoute client-facing API key to
+ * test that key's policy, not which upstream connection serves the request.
+ */
+export function useProviderConnectionOptions(providerId: string): UseProviderConnectionOptionsResult {
+  const [connections, setConnections] = useState<ProviderConnectionOption[]>([]);
+  const [loading, setLoading] = useState<boolean>(true);
+
+  useEffect(() => {
+    if (!providerId) {
+      setConnections([]);
+      setLoading(false);
+      return;
+    }
+    let cancelled = false;
+    const load = async () => {
+      setLoading(true);
+      try {
+        const res = await fetch(`/api/providers?provider=${encodeURIComponent(providerId)}`);
+        if (!res.ok) return;
+        const data = (await res.json()) as { connections?: ProviderConnectionOption[] };
+        if (cancelled) return;
+        setConnections(Array.isArray(data.connections) ? data.connections : []);
+      } catch {
+        // silently ignore — the playground is non-critical
+      } finally {
+        if (!cancelled) setLoading(false);
+      }
+    };
+    void load();
+    return () => {
+      cancelled = true;
+    };
+  }, [providerId]);
+
+  return { connections, loading };
+}
diff --git a/tests/unit/playground-connection-select.test.ts b/tests/unit/playground-connection-select.test.ts
new file mode 100644
index 000000000..d8f15bd3b
--- /dev/null
+++ b/tests/unit/playground-connection-select.test.ts
@@ -0,0 +1,41 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+
+const { resolvePlaygroundKeyId, shouldOfferConnectionSelector } = await import(
+  "../../src/app/(dashboard)/dashboard/media-providers/components/LlmChatCard.tsx"
+);
+
+// The playground's "Select Key" control (an OmniRoute client-facing API key,
+// tests that key's policy) and its "Connection" control (which upstream
+// account actually serves the request, via the X-OmniRoute-Connection
+// header — src/lib/api/modelTestRunner.ts / src/sse/handlers/chat.ts) answer
+// different questions and must not be conflated.
+
+test("shouldOfferConnectionSelector hides the picker with zero connections", () => {
+  assert.equal(shouldOfferConnectionSelector([]), false);
+});
+
+test("shouldOfferConnectionSelector hides the picker with exactly one connection", () => {
+  // Nothing to choose between — showing a single-option dropdown next to
+  // "Select Key" would just be clutter.
+  assert.equal(shouldOfferConnectionSelector([{ id: "conn-1" }]), false);
+});
+
+test("shouldOfferConnectionSelector shows the picker once there is a real choice", () => {
+  assert.equal(
+    shouldOfferConnectionSelector([{ id: "conn-1" }, { id: "conn-2" }]),
+    true
+  );
+});
+
+test("resolvePlaygroundKeyId resolves the masked key back to its id", () => {
+  const keys = [
+    { id: "key-1", key: "sk-aaaa****1111" },
+    { id: "key-2", key: "sk-bbbb****2222" },
+  ];
+  assert.equal(resolvePlaygroundKeyId("sk-bbbb****2222", keys), "key-2");
+});
+
+test("resolvePlaygroundKeyId returns null for the default (no key selected)", () => {
+  assert.equal(resolvePlaygroundKeyId("", [{ id: "key-1", key: "sk-aaaa" }]), null);
+});
