+import { test } from "node:test";
+import assert from "node:assert/strict";
+import { buildProviderDetailsHref } from "../../src/app/(dashboard)/dashboard/providers/components/onboarding/providerOnboardingHref";
+
+// Regression guard: the dashboard detail route `/dashboard/providers/[id]`
+// (ProviderDetailPageClient.tsx) resolves `params.id` as the provider
+// catalog slug (e.g. "dahl") via resolveDashboardProviderInfo(), or as a
+// compatible-node id via `/api/provider-nodes` (`entry.id === providerId`).
+// It never looks up a connection by its own row id. The onboarding wizard
+// itself creates connections with `provider: selectedProvider.id` (built-in)
+// or `provider: node.id` (compatible) — so `connection.provider` is exactly
+// the routing id the details page expects, while `connection.id` (the
+// credential row's own UUID) is not looked up anywhere on that page and
+// 404s as "Provider not found".
+
+test("buildProviderDetailsHref routes by the connection's provider slug", () => {
+  const href = buildProviderDetailsHref({
+    id: "9f3c1a4d-1c2b-4a3c-8def-0123456789ab",
+    provider: "dahl",
+  });
+  assert.equal(href, "/dashboard/providers/dahl");
+});
+
+test("buildProviderDetailsHref does not leak the connection row id into the URL", () => {
+  const href = buildProviderDetailsHref({
+    id: "b0beb806-5081-487f-b995-b85f30ca07f6",
+    provider: "dahl",
+  });
+  assert.notEqual(href, "/dashboard/providers/b0beb806-5081-487f-b995-b85f30ca07f6");
+});
+
+test("buildProviderDetailsHref works for a compatible-node connection (provider = node id)", () => {
+  const href = buildProviderDetailsHref({
+    id: "9f3c1a4d-1c2b-4a3c-8def-0123456789ab",
+    provider: "compat-node-abc123",
+  });
+  assert.equal(href, "/dashboard/providers/compat-node-abc123");
+});
+
+test("buildProviderDetailsHref returns null when no provider slug is available", () => {
+  assert.equal(buildProviderDetailsHref(null), null);
+  assert.equal(buildProviderDetailsHref(undefined), null);
+  assert.equal(buildProviderDetailsHref({ id: "abc", provider: "" }), null);
+  assert.equal(buildProviderDetailsHref({ id: "abc", provider: "   " }), null);
+  assert.equal(buildProviderDetailsHref({ id: "abc" }), null);
+});
+
+test("buildProviderDetailsHref percent-encodes unusual provider slugs", () => {
+  const href = buildProviderDetailsHref({ id: "abc", provider: "abc/123 def" });
+  assert.equal(href, "/dashboard/providers/abc%2F123%20def");
+});
