+// LOCAL PATCH 0013 — leaf module holding one string constant.
+//
+// WHY: v3.8.51 commit 8c5eff1bb ("fix(oauth): align codebuddy-cn OAuth User-Agent with
+// chat/usage", #12702/#13264) made the codebuddy-cn PROVIDER REGISTRY ENTRY import this
+// constant from ./oauth.ts. That file imports CURSOR_AGENT_CLI_VERSION from
+// open-sse/utils/cursorAgentCliVersion.ts, which reads the filesystem (node:fs/os/path).
+//
+// One import line therefore tainted the entire provider registry:
+//
+//   registry/codebuddy-cn/index.ts -> lib/oauth/constants/oauth.ts
+//     -> open-sse/utils/cursorAgentCliVersion.ts -> node:fs
+//
+// and the registry is the root of open-sse/config/providers/index.ts ->
+// providerRegistry.ts -> providerModels.ts -> src/shared/constants/models.ts, which 333
+// of the 768 "use client" boundaries import. That is the bulk of the jump from 41 tainted
+// client boundaries on v3.8.50 to 358 on v3.8.51, and why `next build` could not produce
+// a browser bundle (Turbopack: "the chunking context does not support external modules
+// (request: node:fs)"; webpack: UnhandledSchemeError on the node: scheme).
+//
+// The constant is a plain string, so it does not belong behind that graph. oauth.ts
+// re-exports it below, so every existing importer is unaffected and the "single source of
+// truth" the oauth.ts comment demands across OAuth / chat / usage still holds.
+//
+// KEEP THIS FILE IMPORT-FREE.
+
+// CODEBUDDY_CN_USER_AGENT is the single source of truth for the CLI/CodeBuddy version
+// string. It MUST stay identical across OAuth (./oauth.ts), chat completions
+// (open-sse/config/providers/registry/codebuddy-cn/index.ts) and usage/quota
+// (open-sse/services/usage/codebuddy-cn.ts) — a mismatched version string across a
+// single account's auth vs. chat calls is exactly the kind of internally-inconsistent
+// client fingerprint Tencent's WAF flags as anomalous (#12702).
+export const CODEBUDDY_CN_USER_AGENT = "CLI/2.108.1 CodeBuddy/2.108.1";
