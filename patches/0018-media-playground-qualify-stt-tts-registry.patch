diff --git a/src/app/(dashboard)/dashboard/providers/utils/mediaModels.ts b/src/app/(dashboard)/dashboard/providers/utils/mediaModels.ts
new file mode 100644
--- /dev/null
+++ b/src/app/(dashboard)/dashboard/providers/utils/mediaModels.ts
@@ -0,0 +1,37 @@
+/**
+ * Prefix a model id with the connection provider id, unless it already has it.
+ * The image / speech / transcription routes resolve the provider from the leading
+ * segment of the submitted model id, so a bare id such as "flux-1-schnell" can
+ * resolve to an unrelated built-in provider.
+ */
+export function qualifyModelId(providerId: string, id: string): string {
+  return id.startsWith(`${providerId}/`) ? id : `${providerId}/${id}`;
+}
+
+function asRecord(v: unknown): Record<string, unknown> | null {
+  return v && typeof v === "object" ? (v as Record<string, unknown>) : null;
+}
+
+/**
+ * Transcript text from a speech-to-text response. Handles the OpenAI shape
+ * ({ text }), the Logfare whisper shape ({ result: { text } }) and the Logfare
+ * Deepgram-style nova shape
+ * ({ result: { results: { channels: [{ alternatives: [{ transcript }] }] } } }).
+ */
+export function extractTranscript(data: unknown): string | null {
+  const d = asRecord(data);
+  if (!d) return null;
+  if (typeof d.text === "string") return d.text;
+  const result = asRecord(d.result);
+  if (!result) return null;
+  if (typeof result.text === "string") return result.text;
+  const channels = asRecord(result.results)?.channels;
+  if (Array.isArray(channels)) {
+    const alternatives = asRecord(channels[0])?.alternatives;
+    if (Array.isArray(alternatives)) {
+      const transcript = asRecord(alternatives[0])?.transcript;
+      if (typeof transcript === "string") return transcript;
+    }
+  }
+  return null;
+}
diff --git a/tests/unit/playground-media-models.test.ts b/tests/unit/playground-media-models.test.ts
new file mode 100644
--- /dev/null
+++ b/tests/unit/playground-media-models.test.ts
@@ -0,0 +1,48 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import {
+  qualifyModelId,
+  extractTranscript,
+} from "../../src/app/(dashboard)/dashboard/providers/utils/mediaModels.ts";
+
+test("qualifyModelId prefixes a bare model id with the provider id", () => {
+  assert.equal(qualifyModelId("logfare", "flux-1-schnell"), "logfare/flux-1-schnell");
+});
+
+test("qualifyModelId leaves an already qualified id alone", () => {
+  assert.equal(qualifyModelId("logfare", "logfare/aura-2-en"), "logfare/aura-2-en");
+});
+
+test("qualifyModelId keeps vendor-prefixed ids under the connection provider", () => {
+  assert.equal(
+    qualifyModelId("openrouter", "openai/gpt-image-1"),
+    "openrouter/openai/gpt-image-1"
+  );
+});
+
+test("extractTranscript reads the OpenAI-style top-level text", () => {
+  assert.equal(extractTranscript({ text: "hello world" }), "hello world");
+});
+
+test("extractTranscript reads the Logfare whisper result.text shape", () => {
+  assert.equal(
+    extractTranscript({ result: { text: "Hello from OmniRoute.", word_count: 3 } }),
+    "Hello from OmniRoute."
+  );
+});
+
+test("extractTranscript reads the Logfare nova Deepgram-style transcript", () => {
+  const data = {
+    result: {
+      results: { channels: [{ alternatives: [{ transcript: "good morning", confidence: 0.99 }] }] },
+    },
+  };
+  assert.equal(extractTranscript(data), "good morning");
+});
+
+test("extractTranscript returns null for unknown shapes and bad input", () => {
+  assert.equal(extractTranscript({ foo: 1 }), null);
+  assert.equal(extractTranscript(null), null);
+  assert.equal(extractTranscript("x"), null);
+  assert.equal(extractTranscript({ result: { results: { channels: [] } } }), null);
+});
