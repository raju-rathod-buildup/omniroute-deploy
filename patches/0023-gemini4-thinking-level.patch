+    | undefined;
+  if (model.toLowerCase().startsWith("gemini-4") && typeof geminiThinkingConfig?.thinkingBudget === "number") {
+    const budget = geminiThinkingConfig.thinkingBudget;
+    delete geminiThinkingConfig.thinkingBudget;
+    geminiThinkingConfig.thinkingLevel = budget <= 1024 ? "low" : budget <= 10240 ? "medium" : "high";
