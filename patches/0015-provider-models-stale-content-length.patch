+// Mirrors resolvePublicOwnerId()'s prefix resolution in
+// src/app/api/v1/models/catalog.ts: the catalog never leaks a compatible
+// node's raw internal id/uuid into the public `owned_by` field, it resolves
+// to the operator's configured prefix (falling back to a slugified name)
+// there instead. This route must resolve a connection-id-shaped `provider`
+// param the same way before filtering by `owned_by`, or the filter can
+// never match — every compatible provider's model list came back empty.
+function resolveCompatibleNodePrefix(node: { prefix?: unknown; name?: unknown } | null): string | null {
+  if (!node) return null;
+  const prefix = typeof node.prefix === "string" ? node.prefix.trim() : "";
+  if (prefix) return prefix;
+  const name = typeof node.name === "string" ? node.name.trim() : "";
+  if (!name) return null;
+  const slug = name.toLowerCase().replace(/\s+/g, "-").replace(/[^a-z0-9-]/g, "");
+  return slug || null;
+}
 
