+test("GET /v1/providers/:provider/models never advertises a Content-Length larger than the actual body", async () => {
+  // Regression guard: the route clones getUnifiedModelsResponse()'s response
+  // (often the whole multi-provider catalog — hundreds of KB), filters it
+  // down to this one provider's (usually much smaller) subset, then used to
+  // forward the ORIGINAL response's headers verbatim onto the NEW, shorter
+  // body. That carried a stale, too-large Content-Length onto the filtered
+  // body: the client was promised N bytes but the connection closed after
+  // the real (smaller) body was written — "upstream prematurely closed
+  // connection" at the proxy, `TypeError: Failed to fetch` in the browser.
+  // A provider with zero matches (real, valid compatible-connection-id shape,
+  // but no models registered under it) reproduces the worst case: the full
+  // unfiltered catalog's Content-Length forwarded onto an empty `data: []`.
+  serviceModelsDb.saveServiceModels("cliproxyapi", [{ id: "cli/gpt-5", name: "GPT-5" }]);
+
+  const res = await callGET("cliproxyapi");
+  const bodyText = await res.text();
+  const actualBytes = new TextEncoder().encode(bodyText).length;
+  const declaredLength = res.headers.get("content-length");
+
+  if (declaredLength !== null) {
+    assert.equal(
+      Number(declaredLength),
+      actualBytes,
+      `Content-Length (${declaredLength}) must match the actual filtered body (${actualBytes} bytes), ` +
+        "not a stale length inherited from the unfiltered upstream response"
+    );
+  }
+  assert.equal(res.headers.get("content-encoding"), null);
+});
+
+test("GET /v1/providers/:provider/models resolves a compatible connection ID to its node prefix for owned_by filtering", async () => {
+  // Regression guard: the catalog (src/app/api/v1/models/catalog.ts,
+  // resolvePublicOwnerId) deliberately tags a compatible provider node's
+  // models with its PUBLIC PREFIX in `owned_by`, never the raw node
+  // id/uuid, so internal ids never leak into a public API response. This
+  // route filtered by `owned_by === rawProvider` (the raw connection-id
+  // param) without ever resolving it to that same prefix first — so the
+  // filter could never match, and every compatible provider's playground
+  // model dropdown and "Available Models" list came back empty even when
+  // models were successfully synced (confirmed live for a real "apmix"
+  // node: owned_by was "apmix", the route was filtering for the raw
+  // "openai-compatible-chat-<uuid>" id).
+  const nodeId = "openai-compatible-chat-0000dead-0000-0000-0000-000000000000";
+  await nodesDb.createProviderNode({
+    id: nodeId,
+    type: "openai-compatible",
+    name: "Test Compat Provider",
+    prefix: "testprefix",
+    baseUrl: "https://example.com",
+    apiType: "chat",
+  });
+  // getAllActiveSyncedModels() (src/lib/db/models/activeSyncedCatalog.ts) only
+  // surfaces synced models for connection ids that also have a matching
+  // ACTIVE provider_connections row — a bare provider_nodes row is not enough.
+  const connection = await providersDb.createProviderConnection({
+    provider: nodeId,
+    authType: "apikey",
+    apiKey: "sk-test-owned-by",
+    name: "test-compat-owned-by",
+    isActive: true,
+    testStatus: "active",
+    priority: 1,
+    providerSpecificData: { prefix: "testprefix", baseUrl: "https://example.com" },
+  });
+  await modelsDb.replaceSyncedAvailableModelsForConnection(nodeId, String(connection.id), [
+    { id: "some-upstream-model", name: "Some Upstream Model" },
+  ]);
+
+  const res = await callGET(nodeId);
+  assert.equal(res.status, 200);
+  const body = await res.json();
+  assert.equal(body.object, "list");
+  assert.deepEqual(
+    body.data.map((model: any) => model.id),
+    ["some-upstream-model"]
+  );
+  assert.equal(body.data[0].owned_by, "testprefix");
+});
