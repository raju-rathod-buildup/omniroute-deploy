+/** Strips unsafe or empty base paths; mirrors the normalizer in modelSyncScheduler. */
+function normalizeInternalBasePath(value: string | undefined): string {
+  const trimmed = value?.trim();
+  if (!trimmed || trimmed === "/") return "";
+  if (!trimmed.startsWith("/") || /[?#\\]/.test(trimmed)) return "";
+  const segments = trimmed.split("/").filter(Boolean);
+  if (segments.some((segment) => segment === "." || segment === "..")) return "";
+  return `/${segments.join("/")}`;
+}
+
+/**
+ * Base URL for OmniRoute own /v1 API, used when the bridge calls back into the
+ * gateway. It must include OMNIROUTE_BASE_PATH (for example /omni): every route
+ * lives under that prefix, so a bare origin hits a path that does not exist and
+ * returns an HTML 404 for every image. Uses dashboardPort, as the combo-test and
+ * model-sync loopbacks do.
+ */
+export function resolveSelfLoopBaseUrl(): string {
+  const { dashboardPort } = getRuntimePorts();
+  return `http://localhost:${dashboardPort}${normalizeInternalBasePath(process.env.OMNIROUTE_BASE_PATH)}/v1`;
+}
