--- /dev/null
+++ b/tests/unit/vision-bridge-self-loop-basepath.test.ts
@@ -0,0 +1,71 @@
+/**
+ * Vision Bridge self-loop must include OMNIROUTE_BASE_PATH.
+ *
+ * On a deployment served under a sub-path (for example /omni) the bridge sent its
+ * image-description calls to http://localhost:<port>/v1, which does not exist
+ * there, so every image failed with an HTML 404 page (90 failures, 0 bridged).
+ * Same defect class as the rerank and combo-test loopbacks.
+ */
+
+import test from "node:test";
+import assert from "node:assert/strict";
+
+const { resolveSelfLoopBaseUrl, resolveVisionBridgeBaseUrl } =
+  await import("../../src/lib/guardrails/visionBridgeHelpers.ts");
+
+const ENV_KEYS = ["OMNIROUTE_BASE_PATH", "VISION_BRIDGE_BASE_URL", "OPENAI_API_URL"];
+const ORIGINAL: Record<string, string | undefined> = {};
+for (const k of ENV_KEYS) ORIGINAL[k] = process.env[k];
+
+test.beforeEach(() => {
+  for (const k of ENV_KEYS) delete process.env[k];
+});
+
+test.afterEach(() => {
+  for (const k of ENV_KEYS) {
+    if (ORIGINAL[k] === undefined) delete process.env[k];
+    else process.env[k] = ORIGINAL[k];
+  }
+});
+
+test("self-loop URL includes the base path when OMNIROUTE_BASE_PATH is set", () => {
+  process.env.OMNIROUTE_BASE_PATH = "/omni";
+  assert.match(resolveSelfLoopBaseUrl(), /^http:\/\/localhost:\d+\/omni\/v1$/);
+});
+
+test("self-loop URL has no prefix when OMNIROUTE_BASE_PATH is unset or root", () => {
+  assert.match(resolveSelfLoopBaseUrl(), /^http:\/\/localhost:\d+\/v1$/);
+  process.env.OMNIROUTE_BASE_PATH = "/";
+  assert.match(resolveSelfLoopBaseUrl(), /^http:\/\/localhost:\d+\/v1$/);
+});
+
+test("self-loop URL normalizes a trailing slash and multi-segment base paths", () => {
+  process.env.OMNIROUTE_BASE_PATH = "/omni/";
+  assert.match(resolveSelfLoopBaseUrl(), /^http:\/\/localhost:\d+\/omni\/v1$/);
+  process.env.OMNIROUTE_BASE_PATH = "/a/b";
+  assert.match(resolveSelfLoopBaseUrl(), /^http:\/\/localhost:\d+\/a\/b\/v1$/);
+});
+
+test("self-loop URL ignores unsafe base paths", () => {
+  for (const bad of ["omni", "/../x", "/a/./b", "/x?y=1", "/x#frag", "/x\\y"]) {
+    process.env.OMNIROUTE_BASE_PATH = bad;
+    assert.match(resolveSelfLoopBaseUrl(), /^http:\/\/localhost:\d+\/v1$/, bad);
+  }
+});
+
+test("resolveVisionBridgeBaseUrl uses the base-path-aware self-loop for non-openai providers", () => {
+  process.env.OMNIROUTE_BASE_PATH = "/omni";
+  assert.match(resolveVisionBridgeBaseUrl("groq/llama-3"), /^http:\/\/localhost:\d+\/omni\/v1$/);
+});
+
+test("resolveVisionBridgeBaseUrl keeps api.openai.com for openai and unprefixed models", () => {
+  process.env.OMNIROUTE_BASE_PATH = "/omni";
+  assert.equal(resolveVisionBridgeBaseUrl("openai/gpt-4o-mini"), "https://api.openai.com/v1");
+  assert.equal(resolveVisionBridgeBaseUrl("gpt-4o-mini"), "https://api.openai.com/v1");
+});
+
+test("VISION_BRIDGE_BASE_URL still wins over the self-loop", () => {
+  process.env.OMNIROUTE_BASE_PATH = "/omni";
+  process.env.VISION_BRIDGE_BASE_URL = "https://vision.example.com/v1";
+  assert.equal(resolveVisionBridgeBaseUrl("groq/llama-3"), "https://vision.example.com/v1");
+});
