+// In-flight Qdrant upserts, keyed by memory id.
+//
+// upsertSemanticMemoryPoint() is deliberately fire-and-forget so a slow vector
+// write never blocks the SQLite insert. That is fine until something deletes the
+// same memory microseconds later: deleteMemory() removes the point BEFORE the
+// in-flight upsert writes it back, leaving an orphan with no SQLite row.
+//
+// verifyExtractionPipeline() does exactly that on every /api/memory/health call —
+// it creates a __extraction_test__ memory and deletes it in a finally block, and
+// the health check returns in ~2ms. Measured on this deploy: 34 orphaned points
+// against 2 real memories, i.e. 94% of the vector store was garbage. Orphans
+// consume slots in Qdrant's top-100 result set before fetchMemoriesByIds() drops
+// them, so retrieval quality degrades silently as they accumulate.
+//
+// deleteMemory() awaits any pending upsert for that id before deleting, which
+// closes the race without making the write path synchronous.
+const pendingQdrantUpserts = new Map<string, Promise<unknown>>();
+
+function trackQdrantUpsert(id: string, p: Promise<unknown>): void {
+  const tracked = p.finally(() => {
+    if (pendingQdrantUpserts.get(id) === tracked) pendingQdrantUpserts.delete(id);
+  });
+  pendingQdrantUpserts.set(id, tracked);
+}
