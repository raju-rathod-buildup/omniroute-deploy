# Copy to .env, chmod 600, and fill in. NEVER commit .env.
#
# JWT_SECRET and API_KEY_SECRET encrypt what is stored in data/storage.sqlite
# (provider keys, API keys, sessions). When restoring a backup from another server
# they MUST be copied from the old .env, or the stored credentials won't decrypt.
# Generate fresh ones only for a brand-new install:  openssl rand -hex 32

# ── 1. Required secrets ──
JWT_SECRET=
API_KEY_SECRET=
OMNIROUTE_WS_BRIDGE_SECRET=
INITIAL_PASSWORD=
OMNIROUTE_MEMORY_RERANK_KEY=

# ── 2. Subpath + public origin ──
# Compiled into the image by scripts/build.sh. Must match, or the entrypoint refuses to start.
OMNIROUTE_BASE_PATH=/omni
NEXT_PUBLIC_BASE_URL=https://YOUR_HOST/omni

# ── 3. Storage ──
DATA_DIR=/app/data

# ── 4. Network (all published on loopback only; nginx is the entrance) ──
PORT=20128
DASHBOARD_PORT=20128
LIVE_WS_PORT=20132
LIVE_WS_HOST=0.0.0.0
LIVE_WS_ALLOWED_ORIGINS=https://YOUR_HOST
LIVE_WS_ALLOWED_HOSTS=YOUR_HOST
NEXT_PUBLIC_LIVE_WS_PUBLIC_URL=wss://YOUR_HOST/omni/live-ws
REDIS_URL=redis://redis:6379

# ── 5. Security posture ──
# Set to true when serving over HTTPS; false only for plain-HTTP testing.
AUTH_COOKIE_SECURE=true
REQUIRE_API_KEY=true
ALLOW_API_KEY_REVEAL=false
# Safe only because nginx on loopback is the sole client.
OMNIROUTE_TRUST_PROXY=true

# ── 6. Runtime ──
OMNIROUTE_MEMORY_MB=3072
NODE_OPTIONS=--max-old-space-size=3072
APP_LOG_LEVEL=info

# Optional — Vertex Express keys: project used for project-scoped URLs.
# Must be correct, or every Vertex key 403s with a billing error.
# VERTEX_EXPRESS_PROJECT_ID=
